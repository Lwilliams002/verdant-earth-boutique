{%- comment -%} Storefront password page. Uses layout/password.liquid. {%- endcomment -%}
<div style="margin-top:1.5rem">
  {%- form 'storefront_password' -%}
    {{ form.errors | default_errors }}
    <div style="display:flex;gap:.5rem;justify-content:center;flex-wrap:wrap">
      <input type="password" name="password" placeholder="Password" aria-label="Password" style="padding:.6rem .8rem;border:1px solid #ccc;border-radius:.4rem">
      <button type="submit" style="padding:.6rem 1.2rem;border:none;border-radius:.4rem;background:#2f3b2f;color:#fff;cursor:pointer">Enter</button>
    </div>
  {%- endform -%}
</div>

