{%- comment -%} =========================== PRODUCT =========================== {%- endcomment -%}
{% elsif template.name == 'product' %}

  {%- comment -%} Ingredient metadata, keyed by product handle {%- endcomment -%}
  {%- capture ing_json -%}
    {%- case product.handle -%}
      {%- when EARTH_HANDLE -%}
        Calendula|Calms irritation|Known for calming irritation and comforting sensitive skin.~
        Chamomile|Gentle &amp; soothing|Naturally calming for delicate, stressed, or easily irritated skin.~
        Jojoba oil|Locks in hydration|Locks in hydration without feeling heavy, helping skin stay soft and balanced.~
        Beeswax|Protective seal|Creates a breathable layer that helps keep skin hydrated longer.~
        Organic Arrowroot Powder|Light texture|Helps absorb excess oil for a soft, smooth, non greasy feel.
      {%- when MOON_HANDLE -%}
        Lavender|Calms the senses|Known for its calming properties that help comfort stressed, sensitive skin.~
        Chamomile|Gentle &amp; soothing|Naturally calming for delicate, stressed, or easily irritated skin.~
        Jojoba Oil|Locks in hydration|Locks in hydration without feeling heavy, helping skin stay soft and balanced.~
        Beeswax|Protective seal|Creates a breathable layer that helps keep skin hydrated.~
        Organic arrowroot powder|Light texture|Helps absorb excess oil for a soft, smooth non greasy feel.
      {%- else -%}
        Organic Herbs|Whole plant|Whole plant botanicals from farms we trust, chosen for purity and potency.~
        Clean Carrier Oils|Nourishing base|Cold pressed plant oils never seed oils that carry active botanicals into the skin.~
        Small Batch Craft|Made by hand|Formulated and poured in small batches to preserve freshness and integrity.~
        No Synthetics|Nothing hidden|Free from synthetic fragrance, dyes, and fillers. Just what belongs.
    {%- endcase -%}
  {%- endcapture -%}
  {%- assign ingredients = ing_json | strip | split: '~' -%}

  {%- case product.handle -%}
    {%- when MOON_HANDLE -%}
      {%- assign uses_list = 'Temples,Neck,Shoulders,Chest,Wrists,Hands,Legs,Feet,Dry skin areas' | split: ',' -%}
      {%- assign uses_note = 'For relaxation and a restful night.' -%}
    {%- when EARTH_HANDLE -%}
      {%- assign uses_list = 'Neck,Arms,Elbows,Hands,Legs,Feet,Dry skin areas' | split: ',' -%}
      {%- assign uses_note = '' -%}
    {%- else -%}
      {%- assign uses_list = '' | split: ',' -%}
      {%- assign uses_note = '' -%}
  {%- endcase -%}

  <section class="et-pdp">
    <div class="et-center">
      <span class="et-eyebrow" style="color:var(--moss)">{{ product.type | default: 'Product' }}</span>
      <h1 class="et-pdp__title">{{ product.title }}</h1>
      {% if product.vendor != blank %}
        <p class="et-mt-sm et-italic" style="font-family:var(--font-display);font-size:1.75rem;color:var(--moss)">{{ product.vendor }}</p>
      {% endif %}
    </div>

    <div class="et-pdp__stage">
      <div class="et-pdp__side et-pdp__side--l">
        {% for row in ingredients limit: 2 %}
          {%- assign parts = row | strip | split: '|' -%}
          <div style="margin-left:auto;max-width:20rem">
            <span class="et-eyebrow" style="color:var(--moss)">{{ parts[1] }}</span>
            <h3 class="et-mt-sm" style="font-size:1.5rem">{{ parts[0] }}</h3>
            <p class="et-mt-sm et-fg70" style="font-size:.875rem;line-height:1.7">{{ parts[2] }}</p>
          </div>
        {% endfor %}
      </div>

      <div class="et-pdp__bottle">
        <div class="et-pdp__figure" id="et-pdp-figure">
          <span class="et-ring et-ring--a"></span>
          <span class="et-ring et-ring--b"></span>
          {% if product.featured_image %}
            <img id="et-pdp-main" src="{{ product.featured_image | image_url: width: 900 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" width="900" height="900">
          {% endif %}
        </div>
        {% if product.images.size > 1 %}
          <div class="et-pdp__thumbs">
            {% for img in product.images %}
              <button type="button" class="et-pdp__thumb{% if img == product.featured_image %} is-active{% endif %}" aria-label="View image {{ forloop.index }}" data-full="{{ img | image_url: width: 900 }}">
                <img src="{{ img | image_url: width: 140 }}" alt="{{ product.title | escape }} — view {{ forloop.index }}" loading="lazy" width="70" height="70">
              </button>
            {% endfor %}
          </div>
          <p class="et-pdp__swipe et-fg60">Swipe or tap to view more</p>
          <script>
            (function(){
              var figure = document.getElementById('et-pdp-figure');
              var main = document.getElementById('et-pdp-main');
              var thumbs = Array.prototype.slice.call(document.querySelectorAll('.et-pdp__thumb'));
              if (!thumbs.length || !main) return;
              var idx = 0;
              for (var j = 0; j < thumbs.length; j++){ if (thumbs[j].classList.contains('is-active')) { idx = j; break; } }
              function show(i){
                idx = (i + thumbs.length) % thumbs.length;
                var src = thumbs[idx].getAttribute('data-full');
                if (src) main.src = src;
                for (var k = 0; k < thumbs.length; k++){ thumbs[k].classList.remove('is-active'); }
                thumbs[idx].classList.add('is-active');
                thumbs[idx].scrollIntoView({block:'nearest', inline:'center', behavior:'smooth'});
              }
              thumbs.forEach(function(t, i){ t.addEventListener('click', function(){ show(i); }); });
              var x0 = null;
              if (figure){
                figure.addEventListener('touchstart', function(e){ x0 = e.touches[0].clientX; }, {passive:true});
                figure.addEventListener('touchend', function(e){
                  if (x0 === null) return;
                  var dx = e.changedTouches[0].clientX - x0;
                  if (Math.abs(dx) > 40) { show(dx < 0 ? idx + 1 : idx - 1); }
                  x0 = null;
                }, {passive:true});
              }
            })();
          </script>
        {% endif %}
      </div>

      <div class="et-pdp__side">
        {% for row in ingredients offset: 2 limit: 2 %}
          {%- assign parts = row | strip | split: '|' -%}
          <div style="max-width:20rem">
            <span class="et-eyebrow" style="color:var(--moss)">{{ parts[1] }}</span>
            <h3 class="et-mt-sm" style="font-size:1.5rem">{{ parts[0] }}</h3>
            <p class="et-mt-sm et-fg70" style="font-size:.875rem;line-height:1.7">{{ parts[2] }}</p>
          </div>
        {% endfor %}
      </div>
    </div>

    <div class="et-ing-mobile">
      {% for row in ingredients %}
        {%- assign parts = row | strip | split: '|' -%}
        <div>
          <span class="et-eyebrow" style="color:var(--moss)">{{ parts[1] }}</span>
          <h3 style="font-size:1.125rem;margin-top:.25rem">{{ parts[0] }}</h3>
          <p class="et-fg70" style="font-size:.75rem;line-height:1.6;margin-top:.25rem">{{ parts[2] }}</p>
        </div>
      {% endfor %}
    </div>

    <div class="et-buy">
      <p class="et-center et-fg70" style="line-height:1.8">{{ product.description | strip_html | truncatewords: 60 }}</p>

      <form method="post" action="/cart/add" class="et-mt-lg">
        {% if product.variants.size > 1 %}
          <div class="et-center et-mt">
            <select name="id" class="et-eyebrow" style="padding:.75rem 1rem;border:1px solid var(--border);background:var(--bg)">
              {% for variant in product.variants %}
                <option value="{{ variant.id }}" {% unless variant.available %}disabled{% endunless %}>
                  {{ variant.title }} — {{ variant.price | money }}
                </option>
              {% endfor %}
            </select>
          </div>
        {% else %}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        {% endif %}

        <div class="et-center et-mt-lg" style="font-family:var(--font-display);font-size:1.875rem">
          {{ product.price | money }}
        </div>

        <div class="et-mt" style="display:flex;flex-wrap:wrap;justify-content:center;align-items:center;gap:.75rem">
          <div class="et-qty">
            <button type="button" aria-label="Decrease" onclick="var q=this.parentNode.querySelector('input');q.value=Math.max(1,parseInt(q.value||1)-1)">&minus;</button>
            <input type="number" name="quantity" value="1" min="1" inputmode="numeric" aria-label="Quantity">
            <button type="button" aria-label="Increase" onclick="var q=this.parentNode.querySelector('input');q.value=parseInt(q.value||1)+1">&plus;</button>
          </div>
          <button type="submit" class="et-btn" {% unless product.available %}disabled{% endunless %}>
            {% if product.available %}Add to cart{% else %}Sold out{% endif %}
          </button>
        </div>
      </form>
    </div>

    {% if uses_list.size > 0 %}
    <div class="et-uses">
      <div>
        <h3 class="et-eyebrow" style="color:var(--moss)">Directions</h3>
        <p class="et-mt et-fg70" style="font-size:.9rem;line-height:1.7">
          Apply a small amount to dry, rough, or irritated skin as needed. Massage gently until absorbed.
        </p>
      </div>
      <div>
        <h3 class="et-eyebrow" style="color:var(--moss)">Suggested uses</h3>
        <div class="et-chips">
          {% for u in uses_list %}<span class="et-chip">{{ u }}</span>{% endfor %}
        </div>
        {% if uses_note != blank %}
          <p class="et-mt-sm et-muted" style="font-size:.8rem">{{ uses_note }}</p>
        {% endif %}
      </div>
      <div>
        <h3 class="et-eyebrow" style="color:var(--moss)">Storage</h3>
        <p class="et-mt et-fg70" style="font-size:.9rem;line-height:1.7">
          Store in a cool, dry place away from direct sunlight.
        </p>
      </div>
    </div>
    {% endif %}

    {%- assign related = collections.all.products -%}
    {% if related.size > 1 %}
      <div style="margin-top:6rem">
        <h2 class="et-eyebrow et-center et-fg60">You may also like</h2>
        <div class="et-shopgrid">
          {% for p in related limit: 4 %}
            {% unless p.handle == product.handle %}
              <a class="et-shopcard" href="{{ p.url }}">
                <div class="et-shopcard__media">
                  {% if p.featured_image %}
                    <img src="{{ p.featured_image | image_url: width: 600 }}" alt="{{ p.title | escape }}" loading="lazy" width="600" height="800">
                  {% endif %}
                </div>
                <div class="et-card__row">
                  <h3 style="font-size:1.25rem">{{ p.title }}</h3>
                  <span class="et-fg70" style="font-size:.875rem">{{ p.price | money_without_trailing_zeros }}</span>
                </div>
              </a>
            {% endunless %}
          {% endfor %}
        </div>
      </div>
    {% endif %}
  </section>

