    <script>
      function etKiToggle(card){
        card.classList.toggle('is-open');
      }
      function etKiClose(btn){
        btn.closest('.et-kic').classList.remove('is-open');
      }
      function etKiToggleAll(btn){
        var root = btn.closest('.et-keying');
        var open = btn.getAttribute('aria-expanded') !== 'true';
        btn.setAttribute('aria-expanded', open ? 'true' : 'false');
        root.querySelectorAll('.et-kic').forEach(function(card){
          card.classList.toggle('is-open', open);
        });
