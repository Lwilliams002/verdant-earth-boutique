  <script>
    function etShopTab(name){
      var tabs=document.querySelectorAll('.et-tab');
      for(var i=0;i<tabs.length;i++){tabs[i].classList.toggle('is-active',tabs[i].getAttribute('data-tab')===name);}
      var panels=document.querySelectorAll('.et-tabpanel');
      for(var j=0;j<panels.length;j++){panels[j].hidden = panels[j].getAttribute('data-panel')!==name;}
      if(name==='bundles'){try{history.replaceState(null,'','#bundles');}catch(e){}}
    }
    (function(){ if(location.hash==='#bundles'){etShopTab('bundles');} })();

    /* ---- Build your own bundle: select any 2+ balms, $5 off each ---- */
    function etMoney(cents){ return '$' + (cents/100).toFixed(2); }
    function etByobSelected(){
      return Array.prototype.slice.call(document.querySelectorAll('.et-byob__card.is-selected'));
    }
    function etByobPerItem(){
      var s=document.getElementById('et-byob-summary');
      return s ? (parseInt(s.getAttribute('data-per'),10)||500) : 500;
    }
    function etByobRecalc(){
      var sel=etByobSelected(), count=sel.length, subtotal=0, i;
      for(i=0;i<count;i++){ subtotal += parseInt(sel[i].getAttribute('data-price'),10)||0; }
      var per=etByobPerItem(), meets=count>=2;
      var savings=meets?per*count:0, total=subtotal-savings;
      var sum=document.getElementById('et-byob-summary');
      var add=document.getElementById('et-byob-add');
      if(!sum||!add) return;
      if(meets){
        sum.innerHTML = count + ' balms selected · <s>' + etMoney(subtotal) + '</s> <strong>' + etMoney(total) + '</strong> <em>Save ' + etMoney(savings) + '</em>';
        add.disabled=false;
      } else {
        sum.textContent = 'Select at least 2 balms to unlock ' + etMoney(per) + ' off each.';
        add.disabled=true;
      }
    }
    function etByobToggle(btn){ btn.classList.toggle('is-selected'); etByobRecalc(); }
    function etByobSubmit(form){
      var sel=etByobSelected();
      if(sel.length<2) return false;
      var old=form.querySelectorAll('.et-byob-dyn'), i;
      for(i=0;i<old.length;i++){ old[i].parentNode.removeChild(old[i]); }
      for(i=0;i<sel.length;i++){
        var idInput=document.createElement('input');
        idInput.type='hidden'; idInput.name='items['+i+'][id]'; idInput.value=sel[i].getAttribute('data-variant'); idInput.className='et-byob-dyn';
        form.appendChild(idInput);
        var qtyInput=document.createElement('input');
        qtyInput.type='hidden'; qtyInput.name='items['+i+'][quantity]'; qtyInput.value='1'; qtyInput.className='et-byob-dyn';
        form.appendChild(qtyInput);
      }
      return true;
    }
  </script>

