{%- comment -%} ========================== OUR STORY ========================== {%- endcomment -%}
{% elsif template.name == 'page' and page.handle == 'about' %}

  <section style="position:relative;overflow:hidden">
    <div style="position:absolute;inset:0;z-index:0;opacity:.4;background:url('{{ 'botanical-bg.jpg' | asset_url }}') center/cover"></div>
    <div style="position:absolute;inset:0;z-index:1;background:linear-gradient(to bottom,color-mix(in oklab,var(--bg) 70%,transparent),var(--bg))"></div>
