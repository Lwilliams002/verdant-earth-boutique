{% comment %}
============================================================================
  EARTH & TONIC — COMPLETE SITE IN ONE LIQUID FILE
============================================================================

  HOW TO INSTALL (5 minutes, no code editor needed beyond Shopify's)

  1. Shopify admin > Online Store > Themes > ... > Edit code
  2. Sections > Add a new section > name it: earth-and-tonic
     Delete everything Shopify puts in it and paste this entire file.
  3. Layout > theme.liquid — inside <body>, replace the theme's own
     header/main/footer with just:

         {% section 'earth-and-tonic' %}

     (Keep {{ content_for_header }} in <head> and
      {{ content_for_layout }} nowhere — this file
      renders every page itself.)
  4. Assets > Add a new asset — upload these images with these exact names:
         founder-story.png
         product-duo-boxed.jpg
         product-earth-balm-collection.png
         botanical-bg.jpg
         gallery-kitchen.jpg
         gallery-founder-duo.jpg
         gallery-moon-balm-portrait.jpg
         gallery-moon-balm-blanket.jpg
         gallery-moon-balm-lifestyle.jpg
         gallery-new-1.jpg
         gallery-new-2.jpg
         gallery-new-3.jpg
         gallery-new-4.jpg
  5. Online Store > Pages — create two pages so the nav links resolve:
         "Our Story"  with handle: about
         "Gallery"    with handle: gallery
     (Content can be blank; this file supplies the layout.)

  WHAT RENDERS WHERE
     template = index       -> Home
     template = collection  -> Shop (all products)
     template = product     -> Product page (centered bottle + ingredients)
     page handle = about    -> Our Story
     page handle = gallery  -> Gallery
     anything else          -> theme's own content

  Cart and checkout use Shopify's native cart — no API tokens, no JS SDK.
  The bundle button adds both balms and applies the BUNDLE5 discount.
============================================================================
{% endcomment %}

{%- assign BUNDLE_CODE = 'BUNDLE5' -%}
{%- assign BUNDLE_ALL_CODE = 'BUNDLE20' -%}
{%- comment -%} Build-your-own mix & match code: $5 off each balm (min 2). {%- endcomment -%}
{%- assign BUNDLE_MIX_CODE = 'BUNDLEMIX' -%}
{%- assign BUNDLE_MIX_PER_ITEM = 500 -%}
{%- assign EARTH_HANDLE = 'earth-balm-botanical-skin-balm-2oz' -%}
{%- assign MOON_HANDLE = 'moon-balm-lavender-botanical-balm-2-0z' -%}
{%- assign PEPPERMINT_HANDLE = 'peppermint-balm-natural-skin-balm-2oz' -%}
{%- assign LEMON_HANDLE = 'sweet-lemon-balm-natural-skin-balm-2oz' -%}

<style>
/* ------------------------------- FONTS ------------------------------- */
/* Cormorant Garamond, Inter Tight and Josefin Sans (all weights + italics)
   are loaded via <link> in layout/theme.liquid so italics render correctly. */

/* ------------------------------- TOKENS ------------------------------- */
.et{
  --cream:oklch(0.975 0.006 80);
  --cream-deep:oklch(0.945 0.010 78);
  --forest:oklch(0.32 0.020 45);
  --forest-deep:oklch(0.22 0.015 50);
  --moss:oklch(0.42 0.030 55);
  --sage:oklch(0.86 0.025 55);
  --clay:oklch(0.72 0.055 55);
  --bg:var(--cream);
  --fg:var(--forest-deep);
  --muted-fg:oklch(0.50 0.020 55);
  --border:oklch(0.88 0.010 78);
  --font-display:"Cormorant Garamond",ui-serif,Georgia,serif;
  --font-sans:"Inter Tight",ui-sans-serif,system-ui,sans-serif;
  --font-brand:"Josefin Sans",ui-sans-serif,system-ui,sans-serif;
}

/* ------------------------------- BASE ------------------------------- */
.et,.et *{box-sizing:border-box}
.et{background:var(--bg);color:var(--fg);font-family:var(--font-sans);-webkit-font-smoothing:antialiased;overflow-x:hidden}
.et img{max-width:100%;display:block}
.et a{color:inherit;text-decoration:none}
.et h1,.et h2,.et h3,.et h4{font-family:var(--font-display);font-weight:400;letter-spacing:-.005em;margin:0}
.et p{margin:0}
.et ul{margin:0;padding:0;list-style:none}
.et button{font:inherit;color:inherit;background:none;border:0;cursor:pointer}

.et-eyebrow{font-family:var(--font-brand);font-size:.7rem;letter-spacing:.32em;text-transform:uppercase;font-weight:500}
.et-italic{font-style:italic}
.et-wrap{max-width:1600px;margin:0 auto;padding-left:1.5rem;padding-right:1.5rem}
@media(min-width:1024px){.et-wrap{padding-left:2.5rem;padding-right:2.5rem}}
.et-muted{color:var(--muted-fg)}
.et-fg70{color:color-mix(in oklab,var(--fg) 70%,transparent)}
.et-fg60{color:color-mix(in oklab,var(--fg) 60%,transparent)}
.et-deep{background:var(--cream-deep)}

/* NOTE: rules are prefixed with `.et ` so they out-specify the base
   `.et a{color:inherit}` and `.et button{border:0}` rules above — otherwise
   primary-button text inherits the dark color (invisible) and ghost <button>s
   lose their border. */
.et .et-btn{display:inline-flex;align-items:center;gap:.75rem;padding:1rem 2.25rem;font-family:var(--font-brand);font-size:11px;letter-spacing:.32em;background:var(--fg);color:var(--bg);transition:opacity .25s;text-transform:uppercase}
.et .et-btn:hover{opacity:.85}
.et .et-btn--ghost{background:transparent;color:var(--fg);border:1px solid var(--fg)}
.et .et-btn--ghost:hover{background:var(--fg);color:var(--bg);opacity:1}
.et .et-btn[disabled]{opacity:.4;cursor:not-allowed}
.et .et-link{border-bottom:1px solid color-mix(in oklab,var(--fg) 40%,transparent);padding-bottom:.15rem}
.et .et-link:hover{border-color:var(--fg)}
.et .et-btn--cream{background:var(--cream);color:var(--forest-deep);border-radius:999px;padding:1rem 2.25rem}
.et .et-btn--cream:hover{background:var(--cream);opacity:.9}

/* ------------------------------- HEADER ------------------------------- */
.et-header{position:sticky;top:0;z-index:40;border-bottom:1px solid var(--border);background:color-mix(in oklab,var(--bg) 92%,transparent);backdrop-filter:blur(12px)}
.et-header__in{max-width:1600px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:1rem 1.25rem}
@media(min-width:1024px){.et-header__in{padding:1.25rem 2.5rem}}
.et-nav{display:none;flex:1;gap:2rem;align-items:center}
@media(min-width:768px){.et-nav{display:flex}}
.et-brand{font-family:var(--font-brand);font-weight:200;letter-spacing:.42em;font-size:1.25rem;line-height:1;white-space:nowrap}
@media(min-width:768px){.et-brand{font-size:1.6rem}}
@media(max-width:520px){.et-brand{letter-spacing:.2em;font-size:1rem}}
.et-header__right{display:none;flex:1;justify-content:flex-end;align-items:center;gap:1.5rem}
@media(min-width:768px){.et-header__right{display:flex}}
.et-mobilebar{display:flex;align-items:center;gap:.9rem}
@media(min-width:768px){.et-mobilebar{display:none}}
.et .et-menu-btn{display:inline-flex;align-items:center;justify-content:center;padding:.15rem;color:var(--fg)}
.et-menu-btn svg{display:block}
.et-cart{position:relative;display:inline-flex;align-items:center;gap:.5rem}
.et-cart__count{display:inline-flex;align-items:center;justify-content:center;min-width:18px;height:18px;padding:0 5px;border-radius:999px;background:var(--fg);color:var(--bg);font-size:10px;line-height:1;letter-spacing:0;text-align:center;font-family:var(--font-brand)}
.et-mobilemenu{display:none;border-top:1px solid var(--border);padding:1rem 1.25rem 1.5rem}
.et-mobilemenu.is-open{display:block}
@media(min-width:768px){.et-mobilemenu.is-open{display:none}}
.et-mobilemenu a{display:block;padding:.75rem 0}

/* ------------------------------- HERO ------------------------------- */
.et-hero{border-bottom:1px solid var(--border)}
.et-hero__grid{display:grid;grid-template-columns:1fr;min-height:78vh}
@media(min-width:1024px){.et-hero__grid{grid-template-columns:1fr 1fr}}
.et-hero__copy{order:2;display:flex;flex-direction:column;justify-content:center;padding:4rem 1.5rem}
@media(min-width:1024px){.et-hero__copy{order:1;padding:6rem 4rem}}
.et-hero__title{font-size:clamp(2.75rem,6vw,5.5rem);line-height:1.02;letter-spacing:-.02em;margin-top:1.5rem}
.et-hero__media{order:1;position:relative;overflow:hidden;background:var(--cream-deep)}
@media(min-width:1024px){.et-hero__media{order:2}}
.et-hero__media img{width:100%;height:100%;min-height:60vh;object-fit:contain;padding:3rem 2.5rem}
@media(min-width:1024px){.et-hero__media img{min-height:78vh}}
.et-hero__cap{position:absolute;left:1.5rem;right:1.5rem;bottom:1.5rem;display:flex;align-items:flex-end;justify-content:space-between;gap:1rem}

/* ------------------------------ MARQUEE ------------------------------ */
.et-marquee{overflow:hidden;border-top:1px solid var(--border);border-bottom:1px solid var(--border);background:var(--cream-deep);padding:1.25rem 0}
.et-marquee__track{display:flex;gap:3rem;white-space:nowrap;width:max-content;animation:et-marquee 38s linear infinite}
@keyframes et-marquee{from{transform:translateX(0)}to{transform:translateX(-50%)}}

/* ------------------------------ SECTIONS ------------------------------ */
.et-split{display:grid;grid-template-columns:1fr;max-width:1600px;margin:0 auto}
@media(min-width:768px){.et-split{grid-template-columns:1fr 1fr}}
.et-split__media{position:relative;aspect-ratio:4/5;overflow:hidden;background:var(--cream-deep)}
.et-split__media img{width:100%;height:100%;object-fit:contain;padding:2.5rem 2rem}
.et-split__body{display:flex;flex-direction:column;justify-content:center;padding:4rem 2rem}
@media(min-width:1024px){.et-split__body{padding:4rem 5rem}}
.et-h2{font-size:3rem;line-height:1.05;margin-top:1.5rem}
@media(min-width:768px){.et-h2{font-size:3.75rem}}

.et-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:3.5rem 1.5rem}
@media(min-width:1024px){.et-grid{grid-template-columns:repeat(4,1fr);gap:3.5rem 2rem}}
.et-card__media{position:relative;aspect-ratio:4/5;overflow:hidden;background:var(--cream-deep)}
.et-card__media img{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;padding:1.5rem;transition:opacity .5s}
.et-card__media img.et-alt{opacity:0}
.et-card:hover .et-card__media img.et-main{opacity:0}
.et-card:hover .et-card__media img.et-alt{opacity:1}
.et-card__row{display:flex;justify-content:space-between;gap:.75rem;margin-top:1.25rem}

.et-story{border-top:1px solid var(--border);border-bottom:1px solid var(--border);background:var(--cream-deep)}
.et-story__grid{display:grid;grid-template-columns:1fr;max-width:1600px;margin:0 auto;align-items:stretch}
@media(min-width:768px){.et-story__grid{grid-template-columns:1fr 1fr}}
.et-story__media{position:relative;overflow:hidden;aspect-ratio:4/5;background:var(--cream-deep)}
@media(min-width:768px){.et-story__media{aspect-ratio:auto;min-height:100%}}
.et-story__media img{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;object-position:center}

.et-values{display:grid;grid-template-columns:repeat(2,1fr);gap:2rem;max-width:1600px;margin:0 auto;padding:5rem 1.5rem}
@media(min-width:768px){.et-values{grid-template-columns:repeat(4,1fr)}}

/* ------------------------------ BUNDLE ------------------------------ */
.et-bundle{background:var(--forest-deep);color:var(--cream);border-radius:.6rem;overflow:hidden;border:1px solid color-mix(in oklab,var(--cream) 12%,transparent)}
.et-bundle__grid{display:grid;gap:2rem;padding:2rem}
@media(min-width:768px){.et-bundle__grid{grid-template-columns:1fr auto;align-items:center;gap:3rem;padding:3.5rem}}
.et-bundle__tag{display:inline-flex;align-items:center;gap:.5rem;color:var(--sage)}
.et-bundle__title{margin-top:.75rem;font-size:2.5rem;line-height:1.05}
@media(min-width:768px){.et-bundle__title{font-size:3.25rem}}
.et-bundle__title .et-italic{color:var(--sage)}
.et-bundle__desc{margin-top:1rem;max-width:38rem;line-height:1.7;color:color-mix(in oklab,var(--cream) 80%,transparent)}
.et-bundle__items{display:flex;flex-wrap:wrap;gap:1.5rem 2rem;margin-top:1.75rem}
.et-bundle__item{display:flex;align-items:center;gap:.75rem}
.et-bundle__item img{width:4rem;height:4rem;border-radius:.35rem;background:color-mix(in oklab,var(--cream) 10%,transparent);object-fit:contain;padding:.25rem}
.et-bundle__item-name{font-family:var(--font-display);font-size:1.05rem}
.et-bundle__item-price{margin-top:.15rem;font-size:.8rem;color:color-mix(in oklab,var(--cream) 60%,transparent)}
.et-bundle__buy{display:flex;flex-direction:column;align-items:flex-start;gap:1.5rem}
@media(min-width:768px){.et-bundle__buy{align-items:flex-end;text-align:right}}
.et-bundle__was{font-size:.9rem;color:color-mix(in oklab,var(--cream) 55%,transparent);text-decoration:line-through}
.et-bundle__now{font-family:var(--font-display);font-size:2.75rem;line-height:1.1;margin-top:.15rem}
.et-bundle__save{margin-top:.4rem;font-family:var(--font-brand);font-size:.7rem;letter-spacing:.22em;text-transform:uppercase;color:var(--sage)}

/* ---- Build your own (mix & match) bundle ---- */
.et-byob{padding:2rem}
@media(min-width:768px){.et-byob{padding:3.5rem}}
.et-byob__grid{display:grid;grid-template-columns:repeat(2,1fr);gap:.75rem;margin-top:1.75rem}
@media(min-width:640px){.et-byob__grid{grid-template-columns:repeat(3,1fr)}}
@media(min-width:1024px){.et-byob__grid{grid-template-columns:repeat(4,1fr)}}
.et-byob__card{position:relative;display:flex;align-items:center;gap:.75rem;text-align:left;padding:.75rem;border-radius:.4rem;border:1px solid color-mix(in oklab,var(--cream) 15%,transparent);background:color-mix(in oklab,var(--cream) 3%,transparent);color:var(--cream);cursor:pointer;transition:border-color .2s,background .2s}
.et-byob__card:hover{border-color:color-mix(in oklab,var(--cream) 40%,transparent)}
.et-byob__card.is-selected{border-color:var(--sage);background:color-mix(in oklab,var(--cream) 10%,transparent)}
.et-byob__card img{width:3.5rem;height:3.5rem;flex:none;border-radius:.35rem;background:color-mix(in oklab,var(--cream) 10%,transparent);object-fit:contain;padding:.25rem}
.et-byob__card-name{display:block;font-family:var(--font-display);font-size:.95rem;line-height:1.2}
.et-byob__card-price{display:block;font-size:.78rem;color:color-mix(in oklab,var(--cream) 60%,transparent)}
.et-byob__check{position:absolute;right:.5rem;top:.5rem;width:1.25rem;height:1.25rem;border-radius:999px;border:1px solid color-mix(in oklab,var(--cream) 30%,transparent);display:flex;align-items:center;justify-content:center;color:transparent}
.et-byob__card.is-selected .et-byob__check{border-color:var(--sage);background:var(--sage);color:var(--forest-deep)}
.et-byob__foot{display:flex;flex-direction:column;gap:1rem;margin-top:2rem;padding-top:1.5rem;border-top:1px solid color-mix(in oklab,var(--cream) 10%,transparent)}
@media(min-width:640px){.et-byob__foot{flex-direction:row;align-items:center;justify-content:space-between}}
.et-byob__summary{font-size:.9rem;color:color-mix(in oklab,var(--cream) 70%,transparent)}
.et-byob__summary s{color:color-mix(in oklab,var(--cream) 55%,transparent)}
.et-byob__summary strong{font-family:var(--font-display);font-size:1.15rem;color:var(--cream);margin-left:.4rem}
.et-byob__summary em{font-style:normal;font-family:var(--font-brand);font-size:.68rem;letter-spacing:.2em;text-transform:uppercase;color:var(--sage);margin-left:.4rem}
.et-byob__add[disabled]{opacity:.4;cursor:not-allowed}

/* ------------------------------ PRODUCT ------------------------------ */
.et-pdp{max-width:1200px;margin:0 auto;padding:4rem 1.5rem}
@media(min-width:1024px){.et-pdp{padding:6rem 2.5rem}}
.et-pdp__title{font-size:3.5rem;line-height:1;margin-top:.75rem}
@media(min-width:768px){.et-pdp__title{font-size:4.5rem}}
.et-pdp__hero{display:grid;gap:3rem;margin-top:3rem;align-items:start}
@media(min-width:1024px){.et-pdp__hero{grid-template-columns:1fr 1fr;gap:4rem}}
.et-pdp__bottle{position:relative;display:flex;flex-direction:column;align-items:center;gap:1.5rem}
.et-pdp__figure{position:relative;display:flex;align-items:center;justify-content:center}
.et-pdp__figure img{position:relative;z-index:1;width:auto;height:300px;object-fit:contain;filter:drop-shadow(0 30px 40px rgba(60,40,30,.18));animation:et-float 8s ease-in-out infinite}
@media(min-width:640px){.et-pdp__figure img{height:440px}}
@media(min-width:1024px){.et-pdp__figure img{height:560px}}
.et-pdp__thumbs{display:flex;gap:.6rem;max-width:320px;overflow-x:auto;padding-bottom:.35rem;justify-content:center}
.et-pdp__swipe{font-size:.7rem;letter-spacing:.1em;text-transform:uppercase;font-family:var(--font-brand)}
@media(min-width:1024px){.et-pdp__swipe{display:none}}
.et .et-pdp__thumb{flex:none;width:64px;height:64px;padding:0;border:1px solid var(--border);border-radius:.4rem;overflow:hidden;background:var(--cream-deep);cursor:pointer;transition:border-color .2s}
.et .et-pdp__thumb:hover{border-color:color-mix(in oklab,var(--fg) 50%,transparent)}
.et .et-pdp__thumb.is-active{border-color:var(--fg)}
.et-pdp__thumb img{width:100%;height:100%;object-fit:contain;padding:.25rem;animation:none;filter:none}
@keyframes et-float{0%,100%{transform:translateY(-6px)}50%{transform:translateY(6px)}}
.et-ring{position:absolute;aspect-ratio:1;border-radius:999px;border:1px solid color-mix(in oklab,var(--forest) 15%,transparent)}
.et-ring--a{width:88%}
.et-ring--b{width:70%;border-color:color-mix(in oklab,var(--forest) 10%,transparent)}
.et-buy{border:1px solid var(--border);background:color-mix(in oklab,#fff 60%,transparent);padding:2rem;margin-top:2rem}
.et-qty{display:inline-flex;align-items:center;border:1px solid var(--border);border-radius:999px;background:var(--bg)}
.et-qty button{padding:.75rem 1.1rem;color:var(--muted-fg)}
.et-qty input{width:2.5rem;text-align:center;border:0;background:transparent;font:inherit}
.et-uses{display:grid;gap:2rem;margin-top:2rem}
@media(min-width:640px){.et-uses{grid-template-columns:repeat(3,1fr)}}
.et-chips{display:flex;flex-wrap:wrap;gap:.5rem;margin-top:.75rem}
.et-chip{border:1px solid var(--border);padding:.3rem .7rem;font-size:.75rem;border-radius:999px}

/* --------------------------- KEY INGREDIENTS --------------------------- */
.et-keying{max-width:1200px;margin:5rem auto 0}
.et-keying__top{display:flex;align-items:flex-end;justify-content:space-between;gap:1rem;flex-wrap:wrap}
.et-keyheading{font-family:var(--font-display);font-size:2.5rem;line-height:1.05}
.et .et-keying__all{font-family:var(--font-brand);font-size:.7rem;letter-spacing:.2em;text-transform:uppercase;color:var(--moss);text-decoration:underline;text-underline-offset:4px;background:none;border:0;cursor:pointer;padding:0}
.et-keying__grid{margin-top:2rem;display:grid;grid-template-columns:repeat(2,1fr);gap:1.25rem}
@media(min-width:900px){.et-keying__grid{grid-template-columns:repeat(4,1fr)}}
.et-kic{position:relative;aspect-ratio:3/4;border-radius:.5rem;overflow:hidden;background:color-mix(in oklab,var(--sage) 60%,var(--cream));cursor:pointer}
.et-kic>img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform .5s ease}
.et-kic:hover>img,.et-kic.is-open>img{transform:scale(1.04)}
.et-kic__body{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:.5rem;padding:1.25rem;text-align:center;background:linear-gradient(to bottom,rgba(20,18,14,.1),rgba(20,18,14,.52));transition:opacity .35s}
.et-kic__name{font-family:var(--font-display);font-size:1.6rem;line-height:1.15;color:#fff}
.et .et-kic__more{font-family:var(--font-brand);font-size:.62rem;letter-spacing:.2em;text-transform:uppercase;color:#fff;text-decoration:underline;text-underline-offset:4px;background:none;border:0;cursor:pointer;padding:0}
.et-kic__desc{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;padding:1.5rem 1.25rem;background:linear-gradient(to bottom,rgba(20,18,14,.05) 0%,rgba(20,18,14,.88) 45%);opacity:0;transform:translateY(8px);transition:opacity .35s,transform .35s;pointer-events:none}
.et-kic__desc .et-kic__name{margin-bottom:.4rem}
.et-kic__desc p{font-size:.85rem;line-height:1.65;color:rgba(255,255,255,.92);text-align:center;margin:0 0 .85rem}
.et .et-kic__close{font-family:var(--font-brand);font-size:.6rem;letter-spacing:.18em;text-transform:uppercase;color:rgba(255,255,255,.7);text-decoration:underline;text-underline-offset:4px;background:none;border:0;cursor:pointer;padding:0}
.et-kic.is-open .et-kic__body{opacity:0;pointer-events:none}
.et-kic.is-open .et-kic__desc{opacity:1;transform:translateY(0);pointer-events:auto}

/* ------------------------------- SHOP ------------------------------- */
.et-shopgrid{display:grid;grid-template-columns:repeat(2,1fr);gap:2rem 1rem;margin-top:3.5rem}
@media(min-width:1024px){.et-shopgrid{grid-template-columns:repeat(3,1fr);gap:2.5rem}}
.et-shopcard__media{position:relative;aspect-ratio:4/5;display:flex;align-items:center;justify-content:center;overflow:hidden;background:var(--cream-deep)}
.et-shopcard__media img{height:100%;width:100%;object-fit:contain;padding:.75rem;filter:drop-shadow(0 30px 40px rgba(60,40,30,.18));transition:transform .7s}
.et-shopcard:hover .et-shopcard__media img{transform:scale(1.05)}
.et-shop-bundles{margin-top:2.5rem;display:grid;gap:2rem}
/* Shop tabs */
.et-tabs{display:flex;justify-content:center;gap:.5rem;margin-top:2.5rem}
.et .et-tab{font-family:var(--font-brand);font-size:.72rem;letter-spacing:.18em;text-transform:uppercase;padding:.7rem 1.4rem;border:1px solid var(--border);border-radius:999px;background:transparent;color:var(--muted-fg);cursor:pointer;transition:background .2s,color .2s,border-color .2s}
.et .et-tab:hover{color:var(--fg)}
.et .et-tab.is-active{background:var(--forest-deep);color:var(--cream);border-color:var(--forest-deep)}
.et-tabpanel[hidden]{display:none}
/* Bundle with feature image */
.et-bundle--media .et-bundle__grid{grid-template-columns:1fr}
@media(min-width:900px){.et-bundle--media .et-bundle__grid{grid-template-columns:18rem 1fr auto;gap:2.5rem;align-items:center}}
.et-bundle__media{border-radius:.5rem;overflow:hidden;background:color-mix(in oklab,var(--cream) 10%,transparent);align-self:center}
.et-bundle__media img{width:100%;height:auto;display:block;object-fit:contain}

/* ------------------------------- ABOUT ------------------------------- */
.et-dark{background:var(--forest-deep);color:var(--cream);position:relative;overflow:hidden}
.et-about__pattern{position:absolute;inset:0;z-index:0;opacity:.08;mix-blend-mode:screen;background-image:url("{{ 'plant-pattern.jpeg' | asset_url }}");background-size:420px auto;background-repeat:repeat;pointer-events:none}
.et-about__sprig{position:absolute;z-index:1;height:26rem;width:auto;opacity:.55;mix-blend-mode:screen;pointer-events:none}
@media(min-width:768px){.et-about__sprig{height:34rem}}
.et-about__sprig--l{left:-2.5rem;top:3rem}
@media(min-width:768px){.et-about__sprig--l{left:-1rem}}
.et-about__sprig--r{right:-2.5rem;bottom:3rem;transform:scaleX(-1)}
@media(min-width:768px){.et-about__sprig--r{right:-1rem}}
.et-about__grid{position:relative;z-index:2;display:grid;gap:2.5rem;max-width:1100px;margin:0 auto;padding:6rem 1.5rem;align-items:center}
@media(min-width:1024px){.et-about__grid{grid-template-columns:1fr 1.15fr;gap:4rem;padding:8rem 2.5rem}}
.et-frame-wrap{position:relative;max-width:26rem;margin:0 auto;width:100%}
.et-frame{position:relative;border:4px solid color-mix(in oklab,var(--cream) 90%,transparent);background:var(--cream);padding:.5rem;box-shadow:0 25px 50px rgba(0,0,0,.35)}
.et-frame__pic{position:relative;aspect-ratio:4/5;overflow:hidden}
.et-frame__pic img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center top}
.et-badge{position:absolute;bottom:-1rem;right:-1rem;border:1px solid color-mix(in oklab,var(--cream) 30%,transparent);background:color-mix(in oklab,var(--forest-deep) 88%,transparent);backdrop-filter:blur(6px);border-radius:999px;padding:.55rem 1.35rem;text-align:center}
.et-badge__name{display:block;font-family:var(--font-display);font-style:italic;font-size:1.5rem;line-height:1;color:var(--sage)}
.et-badge__role{display:block;font-family:var(--font-brand);font-size:10px;letter-spacing:.22em;text-transform:uppercase;color:color-mix(in oklab,var(--cream) 70%,transparent);margin-top:.15rem}
.et-process{position:relative;z-index:2;display:grid;gap:2.5rem;max-width:1100px;margin:0 auto;padding:6rem 1.5rem}
@media(min-width:768px){.et-process{grid-template-columns:repeat(3,1fr)}}
.et-num{font-family:var(--font-display);font-style:italic;font-size:3rem;color:var(--sage)}

/* ------------------------------ GALLERY ------------------------------ */
.et-gallery{display:grid;grid-template-columns:repeat(2,1fr);grid-auto-rows:220px;gap:.75rem}
@media(min-width:768px){.et-gallery{grid-template-columns:repeat(4,1fr);grid-auto-rows:280px;gap:1rem}}
.et-gallery figure{margin:0;position:relative;overflow:hidden;background:var(--cream-deep)}
.et-gallery img{width:100%;height:100%;object-fit:cover;transition:transform .9s ease-out}
.et-gallery figure:hover img{transform:scale(1.04)}
@media(min-width:768px){
  .et-g-2x2{grid-column:span 2;grid-row:span 2}
  .et-g-1x2{grid-row:span 2}
  .et-g-2x1{grid-column:span 2}
}

/* ------------------------------- FOOTER ------------------------------- */
.et-footer{margin-top:8rem;border-top:1px solid var(--border);background:var(--cream-deep)}
.et-footer__grid{display:grid;gap:3.5rem}
@media(min-width:768px){.et-footer__grid{grid-template-columns:1.4fr 1fr 1fr 1fr}}
.et-news{display:flex;flex-wrap:wrap;gap:.75rem;margin-top:1.25rem;max-width:34rem}
.et-news input{flex:1;min-width:220px;padding:.9rem 1rem;border:1px solid var(--border);background:var(--bg);font:inherit}
.et-rule{border-top:1px solid var(--border);margin-top:4rem;padding-top:3rem}
.et-center{text-align:center}
.et-mt{margin-top:1.5rem}
.et-mt-sm{margin-top:.5rem}
.et-mt-lg{margin-top:2.5rem}
</style>

{%- comment -%} ============ HEADER (every page) ============ {%- endcomment -%}
<div class="et">
<header class="et-header">
  <div class="et-header__in">
    <nav class="et-nav">
      <a class="et-eyebrow" href="/collections/all">Shop</a>
      <a class="et-eyebrow" href="/pages/about">Our Story</a>
      <a class="et-eyebrow" href="/pages/gallery">Gallery</a>
    </nav>

    <a href="/" class="et-brand">EARTH &amp; TONIC</a>

    <div class="et-header__right">
      <a class="et-eyebrow" href="/search">Search</a>
      <a class="et-eyebrow et-cart" href="{{ routes.cart_url }}">
        Cart
        {% if cart.item_count > 0 %}<span class="et-cart__count">{{ cart.item_count }}</span>{% endif %}
      </a>
    </div>

    <div class="et-mobilebar">
      <a class="et-eyebrow et-cart" href="{{ routes.cart_url }}">
        Cart
        {% if cart.item_count > 0 %}<span class="et-cart__count">{{ cart.item_count }}</span>{% endif %}
      </a>
      <button class="et-menu-btn" aria-label="Open menu" aria-expanded="false"
        onclick="var m=document.getElementById('et-mm');var o=m.classList.toggle('is-open');this.setAttribute('aria-expanded',o);this.querySelector('.et-i-open').style.display=o?'none':'block';this.querySelector('.et-i-close').style.display=o?'block':'none';">
        <svg class="et-i-open" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
        <svg class="et-i-close" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true" style="display:none"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>
  </div>
  <div class="et-mobilemenu" id="et-mm">
    <a class="et-eyebrow" href="/collections/all">Shop</a>
    <a class="et-eyebrow" href="/pages/about">Our Story</a>
    <a class="et-eyebrow" href="/pages/gallery">Gallery</a>
  </div>
</header>

{%- comment -%} ============================ HOME ============================ {%- endcomment -%}
{% if template.name == 'index' %}
  {%- assign all_prods = collections.all.products -%}
  {%- assign hero = all_prods.first -%}

  <section class="et-hero">
    <div class="et-hero__grid">
      <div class="et-hero__copy">
        <span class="et-eyebrow et-fg60">Now Available</span>
        <h1 class="et-hero__title">The Botanical<br><span class="et-italic et-fg70">Balm Collection</span></h1>
        <p class="et-mt et-fg70" style="max-width:28rem;line-height:1.7">
          Thoughtfully crafted balms made with herb infused oils and clean ingredients for your everyday routine
        </p>
        <div class="et-mt-lg" style="display:flex;flex-wrap:wrap;align-items:center;gap:1.5rem">
          <a class="et-btn" href="/collections/all">Shop Now &rarr;</a>
          <a class="et-eyebrow et-link" href="/pages/about">Our story</a>
        </div>
      </div>

      <div class="et-hero__media">
        {% if hero and hero.featured_image %}
          <img src="{{ hero.featured_image | image_url: width: 1200 }}" alt="{{ hero.featured_image.alt | default: hero.title | escape }}" width="1200" height="1500">
        {% else %}
          <img src="{{ 'product-earth-balm-collection.png' | asset_url }}" alt="Earth &amp; Tonic balm collection" width="1200" height="1500">
        {% endif %}
        {% if hero %}
          <div class="et-hero__cap">
            <div style="max-width:20rem">
              <div class="et-eyebrow et-fg60">Featured</div>
              <div class="et-mt-sm" style="font-family:var(--font-display);font-size:1.5rem">{{ hero.title }}</div>
            </div>
            <a class="et-eyebrow et-link" href="{{ hero.url }}">{{ hero.price | money_without_trailing_zeros }}</a>
          </div>
        {% endif %}
      </div>
    </div>
  </section>

  <div class="et-marquee">
    <div class="et-marquee__track">
      {% for i in (1..2) %}
        <span class="et-eyebrow">Rooted in Nature</span>
        <span class="et-eyebrow">Small Batch</span>
        <span class="et-eyebrow">Clean Ingredients</span>
        <span class="et-eyebrow">No Seed Oils</span>
        <span class="et-eyebrow">Cruelty Free</span>
        <span class="et-eyebrow">Non GMO</span>
        <span class="et-eyebrow">Crafted for Wellness</span>
      {% endfor %}
    </div>
  </div>

  <section class="et-split">
    <div class="et-split__media">
      <img src="{{ 'product-duo-boxed.jpg' | asset_url }}" alt="Earth Balm and Moon Balm duo" loading="lazy" width="900" height="1125">
    </div>
    <div class="et-split__body">
      <span class="et-eyebrow et-fg60">Introducing</span>
      <h2 class="et-h2">The <span class="et-italic">Routine</span> Duo</h2>
      <p class="et-mt et-fg70" style="max-width:28rem;line-height:1.7">
        Earth Balm and Moon Balm. Your daily skincare essentials, thoughtfully crafted with clean ingredients
      </p>
      <div class="et-mt-lg"><a class="et-btn et-btn--ghost" href="/collections/all">Shop the duo &rarr;</a></div>
    </div>
  </section>

  {% if all_prods.size > 0 %}
  <section class="et-wrap" style="padding-top:6rem;padding-bottom:5rem">
    <div style="display:flex;align-items:flex-end;justify-content:space-between;gap:1.5rem;margin-bottom:3.5rem">
      <div>
        <span class="et-eyebrow et-fg60">Shop</span>
        <h2 class="et-h2" style="font-size:2.5rem;margin-top:.75rem">The <span class="et-italic">Collection</span></h2>
      </div>
      <a class="et-eyebrow et-link" href="/collections/all">View all</a>
    </div>

    <div class="et-grid">
      {% for product in all_prods limit: 8 %}
        <a class="et-card" href="{{ product.url }}">
          <div class="et-card__media">
            {% if product.featured_image %}
              <img class="et-main" src="{{ product.featured_image | image_url: width: 700 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy" width="700" height="875">
            {% endif %}
            {% if product.images[1] %}
              <img class="et-alt" src="{{ product.images[1] | image_url: width: 700 }}" alt="" aria-hidden="true" loading="lazy" width="700" height="875">
            {% endif %}
          </div>
          <div class="et-card__row">
            <div>
              <h3 style="font-family:var(--font-sans);font-size:.875rem;font-weight:500;letter-spacing:.02em">{{ product.title }}</h3>
              <p class="et-mt-sm et-fg60" style="font-size:.75rem">{{ product.type | default: 'Botanical balm' }}</p>
            </div>
            <span class="et-fg70" style="font-size:.875rem">{{ product.price | money_without_trailing_zeros }}</span>
          </div>
        </a>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  {%- comment -%} ---- Bundle: adds both balms + applies BUNDLE5 ---- {%- endcomment -%}
  {%- assign earth = all_products[EARTH_HANDLE] -%}
  {%- assign moon = all_products[MOON_HANDLE] -%}
  {% if earth.available and moon.available %}
  {%- assign bundle_subtotal = earth.price | plus: moon.price -%}
  <section class="et-wrap" style="padding-top:4rem;padding-bottom:4rem;max-width:1200px">
    <div class="et-bundle">
      <div class="et-bundle__grid">
        <div>
          <span class="et-eyebrow et-bundle__tag">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style="flex:none"><path d="M12 2l1.9 5.6L19.5 9l-4.4 3.2L16.8 18 12 14.7 7.2 18l1.7-5.8L4.5 9l5.6-1.4L12 2z"/></svg>
            Limited bundle
          </span>
          <h2 class="et-h2 et-bundle__title">The <span class="et-italic">Routine</span> Bundle</h2>
          <p class="et-bundle__desc">
            Both of our botanical balms together — Earth Balm and Moon Balm for a complete morning and evening routine. Save {{ 500 | money_without_trailing_zeros }} when you take home the pair.
          </p>
          <div class="et-bundle__items">
            <div class="et-bundle__item">
              {% if earth.featured_image %}<img src="{{ earth.featured_image | image_url: width: 160 }}" alt="{{ earth.title | escape }}" width="64" height="64">{% endif %}
              <div>
                <p class="et-bundle__item-name">{{ earth.title }}</p>
                <p class="et-bundle__item-price">{{ earth.price | money }}</p>
              </div>
            </div>
            <div class="et-bundle__item">
              {% if moon.featured_image %}<img src="{{ moon.featured_image | image_url: width: 160 }}" alt="{{ moon.title | escape }}" width="64" height="64">{% endif %}
              <div>
                <p class="et-bundle__item-name">{{ moon.title }}</p>
                <p class="et-bundle__item-price">{{ moon.price | money }}</p>
              </div>
            </div>
          </div>
        </div>

        <div class="et-bundle__buy">
          <div>
            <p class="et-bundle__was">{{ bundle_subtotal | money }}</p>
            <p class="et-bundle__now">{{ bundle_subtotal | minus: 500 | money }}</p>
            <p class="et-bundle__save">Save {{ 500 | money_without_trailing_zeros }}</p>
          </div>
          <form method="post" action="/cart/add">
            <input type="hidden" name="items[0][id]" value="{{ earth.selected_or_first_available_variant.id }}">
            <input type="hidden" name="items[0][quantity]" value="1">
            <input type="hidden" name="items[1][id]" value="{{ moon.selected_or_first_available_variant.id }}">
            <input type="hidden" name="items[1][quantity]" value="1">
            <input type="hidden" name="return_to" value="/discount/{{ BUNDLE_CODE }}?redirect=/cart">
            <button type="submit" class="et-btn et-btn--cream">Add bundle to cart</button>
          </form>
        </div>
      </div>
    </div>
  </section>
  {% endif %}

  <section class="et-story">
    <div class="et-story__grid">
      <div class="et-story__media">
        <img src="{{ 'founder-story.png' | asset_url }}" alt="Pamela, founder of Earth &amp; Tonic" loading="lazy" width="900" height="1125">
      </div>
      <div class="et-split__body">
        <span class="et-eyebrow et-fg60">Our Story</span>
        <h2 class="et-h2"><span class="et-italic">Why</span> I started</h2>
        <div class="et-mt-lg et-fg70" style="display:grid;gap:1.25rem;line-height:1.8">
          <p>Earth &amp; Tonic started during my own health journey after being diagnosed with PCOS. I began researching herbs and natural ingredients to better understand my body, and what started as a personal passion quickly turned into something I genuinely loved.</p>
          <p>I create products with clean, thoughtfully chosen ingredients because I truly believe we don't always need all the extra additives to care for our bodies.</p>
        </div>
        <div class="et-mt-lg">
          <p style="font-family:var(--font-display);font-style:italic;font-size:1.5rem">Pamela</p>
          <p class="et-eyebrow et-fg60 et-mt-sm">Founder, Earth &amp; Tonic</p>
        </div>
        <div class="et-mt-lg"><a class="et-btn et-btn--ghost" href="/pages/about">Read more &rarr;</a></div>
      </div>
    </div>
  </section>

  <section class="et-values">
    <div class="et-center"><h3 class="et-eyebrow">Small Batch</h3><p class="et-mt et-fg60" style="font-size:.875rem">Handcrafted in small quantities.</p></div>
    <div class="et-center"><h3 class="et-eyebrow">Clean Ingredients</h3><p class="et-mt et-fg60" style="font-size:.875rem">Organic, thoughtfully sourced.</p></div>
    <div class="et-center"><h3 class="et-eyebrow">Quality First</h3><p class="et-mt et-fg60" style="font-size:.875rem">Made with ingredients you can trust</p></div>
    <div class="et-center"><h3 class="et-eyebrow">Made with Care</h3><p class="et-mt et-fg60" style="font-size:.875rem">Formulated by our founder.</p></div>
  </section>

{%- comment -%} =========================== PRODUCT =========================== {%- endcomment -%}
{% elsif template.name == 'product' %}

  {%- comment -%} Ingredient metadata, keyed by product handle {%- endcomment -%}
  {%- capture ing_json -%}
    {%- case product.handle -%}
      {%- when EARTH_HANDLE -%}
        Calendula|Calms irritation|Known for calming irritation and comforting sensitive skin.~
        Chamomile|Gentle &amp; soothing|Naturally calming for delicate, stressed, or easily irritated skin.~
        Jojoba oil|Locks in hydration|Locks in hydration without feeling heavy, helping skin stay soft and balanced.~
        Beeswax|Protective seal|Creates a breathable layer that helps keep skin hydrated longer.~
        Organic Arrowroot Powder|Light texture|Helps absorb excess oil for a soft, smooth, non greasy feel.
      {%- when MOON_HANDLE -%}
        Lavender|Calms the senses|Known for its calming properties that help comfort stressed, sensitive skin.~
        Chamomile|Gentle &amp; soothing|Naturally calming for delicate, stressed, or easily irritated skin.~
        Jojoba Oil|Locks in hydration|Locks in hydration without feeling heavy, helping skin stay soft and balanced.~
        Beeswax|Protective seal|Creates a breathable layer that helps keep skin hydrated.~
        Organic arrowroot powder|Light texture|Helps absorb excess oil for a soft, smooth non greasy feel.
      {%- when PEPPERMINT_HANDLE -%}
        Organic Peppermint Essential Oil|Cooling &amp; refreshing|Provides a naturally refreshing aroma and a cooling sensation when applied to the skin.~
        Mango Butter|Softens dry skin|Rich in fatty acids that help soften and moisturize dry skin.~
        Jojoba Oil|Locks in hydration|Locks in hydration without feeling heavy, helping skin stay soft and balanced.~
        Beeswax|Protective seal|Creates a breathable layer that helps keep skin hydrated.~
        Organic Arrowroot Powder|Light texture|Helps absorb excess oil for a soft, smooth, non greasy feel.
      {%- when LEMON_HANDLE -%}
        Organic Lemon Essential Oil|Uplifting citrus|Provides a fresh, uplifting citrus aroma while leaving the skin feeling refreshed.~
        Mango Butter|Softens dry skin|Rich in fatty acids that help soften and moisturize dry skin.~
        Jojoba Oil|Locks in hydration|Locks in hydration without feeling heavy, helping skin stay soft and balanced.~
        Beeswax|Protective seal|Creates a breathable layer that helps keep skin hydrated.~
        Organic Arrowroot Powder|Light texture|Helps absorb excess oil for a soft, smooth, non greasy feel.
      {%- else -%}
        Organic Herbs|Whole plant|Whole plant botanicals from farms we trust, chosen for purity and potency.~
        Clean Carrier Oils|Nourishing base|Cold pressed plant oils never seed oils that carry active botanicals into the skin.~
        Small Batch Craft|Made by hand|Formulated and poured in small batches to preserve freshness and integrity.~
        No Synthetics|Nothing hidden|Free from synthetic fragrance, dyes, and fillers. Just what belongs.
    {%- endcase -%}
  {%- endcapture -%}
  {%- assign ingredients = ing_json | strip | split: '~' -%}

  {%- case product.handle -%}
    {%- when MOON_HANDLE -%}
      {%- assign uses_list = 'Temples,Neck,Shoulders,Chest,Wrists,Hands,Legs,Feet,Dry skin areas' | split: ',' -%}
      {%- assign uses_note = 'For relaxation and a restful night.' -%}
    {%- when EARTH_HANDLE -%}
      {%- assign uses_list = 'Neck,Arms,Elbows,Hands,Legs,Feet,Dry skin areas' | split: ',' -%}
      {%- assign uses_note = '' -%}
    {%- when PEPPERMINT_HANDLE -%}
      {%- assign uses_list = 'Temples,Neck,Shoulders,Chest,Wrists,Hands,Legs,Feet' | split: ',' -%}
      {%- assign uses_note = 'For a cooling, refreshing pick me up.' -%}
    {%- when LEMON_HANDLE -%}
      {%- assign uses_list = 'Neck,Wrists,Chest,Hands,Legs,Feet,Dry skin areas' | split: ',' -%}
      {%- assign uses_note = 'For a fresh, uplifting lift to your routine.' -%}
    {%- else -%}
      {%- assign uses_list = '' | split: ',' -%}
      {%- assign uses_note = '' -%}
  {%- endcase -%}

  <section class="et-pdp">
    <div class="et-center">
      <span class="et-eyebrow" style="color:var(--moss)">{{ product.type | default: 'Product' }}</span>
      <h1 class="et-pdp__title">{{ product.title }}</h1>
      {% if product.vendor != blank %}
        <p class="et-mt-sm et-italic" style="font-family:var(--font-display);font-size:1.75rem;color:var(--moss)">{{ product.vendor }}</p>
      {% endif %}
    </div>

    <div class="et-pdp__hero">

      {%- comment -%} LEFT — product image {%- endcomment -%}
      <div class="et-pdp__bottle">
        <div class="et-pdp__figure" id="et-pdp-figure">
          <span class="et-ring et-ring--a"></span>
          <span class="et-ring et-ring--b"></span>
          {% if product.featured_image %}
            <img id="et-pdp-main" src="{{ product.featured_image | image_url: width: 900 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" width="900" height="900">
          {% endif %}
        </div>
        {% if product.images.size > 1 %}
          <div class="et-pdp__thumbs">
            {% for img in product.images %}
              <button type="button" class="et-pdp__thumb{% if img == product.featured_image %} is-active{% endif %}" aria-label="View image {{ forloop.index }}" data-full="{{ img | image_url: width: 900 }}">
                <img src="{{ img | image_url: width: 140 }}" alt="{{ product.title | escape }} — view {{ forloop.index }}" loading="lazy" width="70" height="70">
              </button>
            {% endfor %}
          </div>
          <p class="et-pdp__swipe et-fg60">Swipe or tap to view more</p>
          <script>
            (function(){
              var figure = document.getElementById('et-pdp-figure');
              var main = document.getElementById('et-pdp-main');
              var thumbs = Array.prototype.slice.call(document.querySelectorAll('.et-pdp__thumb'));
              if (!thumbs.length || !main) return;
              var idx = 0;
              for (var j = 0; j < thumbs.length; j++){ if (thumbs[j].classList.contains('is-active')) { idx = j; break; } }
              function show(i){
                idx = (i + thumbs.length) % thumbs.length;
                var src = thumbs[idx].getAttribute('data-full');
                if (src) main.src = src;
                for (var k = 0; k < thumbs.length; k++){ thumbs[k].classList.remove('is-active'); }
                thumbs[idx].classList.add('is-active');
                thumbs[idx].scrollIntoView({block:'nearest', inline:'center', behavior:'smooth'});
              }
              thumbs.forEach(function(t, i){ t.addEventListener('click', function(){ show(i); }); });
              var x0 = null;
              if (figure){
                figure.addEventListener('touchstart', function(e){ x0 = e.touches[0].clientX; }, {passive:true});
                figure.addEventListener('touchend', function(e){
                  if (x0 === null) return;
                  var dx = e.changedTouches[0].clientX - x0;
                  if (Math.abs(dx) > 40) { show(dx < 0 ? idx + 1 : idx - 1); }
                  x0 = null;
                }, {passive:true});
              }
            })();
          </script>
        {% endif %}
      </div>

