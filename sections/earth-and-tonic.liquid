          <p class="et-italic" style="font-family:var(--font-display);font-size:1.5rem;color:var(--sage)">Pamela</p>
          <p class="et-eyebrow et-mt-sm" style="opacity:.6">Founder, Earth &amp; Tonic</p>
        </div>
      </div>
    </div>
  </section>

  <section class="et-dark">
    <div class="et-process">
      <div>
        <span class="et-num">01</span>
        <h3 style="font-size:1.875rem;margin-top:.75rem">Source</h3>
        <p class="et-mt-sm" style="opacity:.8">We carefully choose every ingredient because what goes into our products matter</p>
      </div>
      <div>
        <span class="et-num">02</span>
        <h3 style="font-size:1.875rem;margin-top:.75rem">Craft</h3>
        <p class="et-mt-sm" style="opacity:.8">Every batch is handcrafted in small quantities</p>
      </div>
      <div>
        <span class="et-num">03</span>
        <h3 style="font-size:1.875rem;margin-top:.75rem">Share</h3>
        <p class="et-mt-sm" style="opacity:.8">Created to become part of your everyday routine</p>
      </div>
    </div>
  </section>

