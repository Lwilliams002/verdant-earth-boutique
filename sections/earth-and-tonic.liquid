  <section class="et-values">
    <div class="et-center"><h3 class="et-eyebrow">Small Batch</h3><p class="et-mt et-fg60" style="font-size:.875rem">Handcrafted in small quantities.</p></div>
    <div class="et-center"><h3 class="et-eyebrow">Clean Ingredients</h3><p class="et-mt et-fg60" style="font-size:.875rem">Organic, thoughtfully sourced.</p></div>
    <div class="et-center"><h3 class="et-eyebrow">Quality First</h3><p class="et-mt et-fg60" style="font-size:.875rem">Made with ingredients you can trust</p></div>
    <div class="et-center"><h3 class="et-eyebrow">Made with Care</h3><p class="et-mt et-fg60" style="font-size:.875rem">Formulated by our founder.</p></div>
