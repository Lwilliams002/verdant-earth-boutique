        <div class="et-mt-lg">
          <p style="font-family:var(--font-display);font-style:italic;font-size:1.5rem">Pamela</p>
          <p class="et-eyebrow et-fg60 et-mt-sm">Founder, Earth &amp; Tonic</p>
        </div>
        <div class="et-mt-lg"><a class="et-btn et-btn--ghost" href="/pages/about">Read more &rarr;</a></div>
      </div>
    </div>
