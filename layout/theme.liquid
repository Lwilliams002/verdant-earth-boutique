<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, height=device-height, minimum-scale=1.0, maximum-scale=1.0">
    <meta name="theme-color" content="#ffffff">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500;1,600;1,700&family=Inter+Tight:wght@300;400;500;600;700&family=Josefin+Sans:wght@200;300;400;500;600;700&display=swap">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- else -%}
      <link rel="icon" type="image/svg+xml" href="{{ 'favicon.svg' | asset_url }}">
      <link rel="apple-touch-icon" href="{{ 'favicon.svg' | asset_url }}">
    {%- endif -%}

    {%- assign et_site_name = 'Earth & Tonic Wellness' -%}
    {%- assign et_description = 'At Earth & Tonic Wellness we create home & body care products with clean ingredients. Every product is thoughtfully made in small batches made for everyday wellness.' -%}
    {%- assign et_og_image = 'founder-story.png' | asset_url -%}

    {%- comment -%} Title: page name + brand on inner pages, just brand on home {%- endcomment -%}
    <title>
      {%- if template.name == 'index' -%}
        {{ et_site_name }}
      {%- else -%}
        {{ page_title }} &ndash; {{ et_site_name }}
      {%- endif -%}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
    </title>

    {%- comment -%} Google / SEO description {%- endcomment -%}
    <meta name="description" content="{%- if page_description != blank -%}{{ page_description | escape }}{%- else -%}{{ et_description | escape }}{%- endif -%}">

    {%- comment -%} Open Graph (Facebook, WhatsApp, iMessage link previews) {%- endcomment -%}
    <meta property="og:site_name" content="{{ et_site_name }}">
    <meta property="og:type" content="{%- if template.name == 'product' -%}product{%- else -%}website{%- endif -%}">
    <meta property="og:url" content="{{ canonical_url }}">
    <meta property="og:title" content="{%- if template.name == 'index' -%}{{ et_site_name }}{%- else -%}{{ page_title }} &ndash; {{ et_site_name }}{%- endif -%}">
    <meta property="og:description" content="{%- if page_description != blank -%}{{ page_description | escape }}{%- else -%}{{ et_description | escape }}{%- endif -%}">
    {%- if template.name == 'product' and product.featured_image -%}
      <meta property="og:image" content="{{ product.featured_image | image_url: width: 1200 }}">
      <meta property="og:image:width" content="1200">
    {%- else -%}
      <meta property="og:image" content="{{ et_og_image }}">
    {%- endif -%}

    {%- comment -%} Twitter / X card {%- endcomment -%}
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{%- if template.name == 'index' -%}{{ et_site_name }}{%- else -%}{{ page_title }} &ndash; {{ et_site_name }}{%- endif -%}">
    <meta name="twitter:description" content="{%- if page_description != blank -%}{{ page_description | escape }}{%- else -%}{{ et_description | escape }}{%- endif -%}">
    {%- if template.name == 'product' and product.featured_image -%}
      <meta name="twitter:image" content="{{ product.featured_image | image_url: width: 1200 }}">
    {%- else -%}
      <meta name="twitter:image" content="{{ et_og_image }}">
    {%- endif -%}

    {{ content_for_header }}
  </head>

  <body class="template-{{ request.page_type | handle }}">
    {%- comment -%}
      The entire storefront (header, home, shop, product, story, gallery,
      footer, cart fallback) is rendered by the single 'earth-and-tonic'
      section. It branches on template.name internally and emits
      {{ content_for_layout }} for any template it does not draw itself.
    {%- endcomment -%}
    {% section 'earth-and-tonic' %}
  </body>
</html>

